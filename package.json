{
  "name": "van-que-browser",
  "productName": "Vân Quẻ Browser",
  "version": "2.0.1",
  "description": "Trình duyệt Huyền Học Phương Đông — Tử Vi, Tử Bình, Bát Trạch, Kỳ Môn Độn Giáp, Hà Đồ Lạc Thư, Kinh Dịch, Vạn Niên Lịch. Lý số chạy hoàn toàn ngoại tuyến.",
  "main": "src/main.js",
  "author": "Vân Quẻ Môn",
  "license": "MIT",
  "homepage": "https://vanque.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datnpq/vanque-browser.git"
  },
  "bugs": {
    "url": "https://github.com/datnpq/vanque-browser/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node test/selftest.js",
    "e2e": "node test/e2e.js light",
    "e2e:dark": "node test/e2e.js dark",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "site:deploy": "npx --yes wrangler pages deploy site --project-name vanque --branch main --commit-dirty=true",
    "dist:store": "node scripts/check-store.js && electron-builder --win appx"
  },
  "build": {
    "appId": "app.vanque.browser",
    "productName": "Vân Quẻ",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vân Quẻ Browser",
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "build/icon.png",
      "artifactName": "VanQue-mac-${arch}.${ext}",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "appx": {
      "applicationId": "VanQue",
      "identityName": "DIEN-TU-PARTNER-CENTER.VanQue",
      "publisher": "CN=DIEN-TU-PARTNER-CENTER",
      "publisherDisplayName": "DIEN-TU-PARTNER-CENTER",
      "displayName": "Vân Quẻ",
      "backgroundColor": "#f4ecd9",
      "languages": [
        "vi-VN"
      ],
      "showNameOnTiles": false,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "capabilities": [
        "runFullTrust",
        "internetClient",
        "webcam",
        "microphone",
        "location"
      ]
    },
    "dmg": {
      "title": "Vân Quẻ",
      "artifactName": "VanQue-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/phudu": "^5.3.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "tuvi": {
    "base": "https://tuvi.work",
    "apiKey": "VANQUE-KHOA-CHUA-CAP"
  }
}
